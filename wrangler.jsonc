{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "puasa-sunnah-api",
	"main": "worker/index.js",
	"compatibility_date": "2026-08-09",
	"containers": [
		{
			"class_name": "PuasaSunnahContainer",
			"image": "./Dockerfile",
			"max_instances": 3
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "API_CONTAINER",
				"class_name": "PuasaSunnahContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PuasaSunnahContainer"]
		}
	]
}
